generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Review {
  id          Int      @id @default(autoincrement())
  name        String
  date        DateTime
  rating      Int
  description String
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  passwordHash     String
  isVerified       Boolean   @default(false)
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
}